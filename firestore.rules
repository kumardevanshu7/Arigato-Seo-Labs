rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access for keywords so Arigato SEO Studio can store and retrieve them
    match /keywords/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
